{
  "$id": "failure-packet",
  "title": "Failure packet",
  "description": "Everything an agent needs to fix a mechanical failure: the raw error, the work order it was working from, and what has already been tried. Built by a script from any stage, never written by a model.",
  "type": "object",
  "required": [
    "issue",
    "stage",
    "error_type",
    "error_signature",
    "raw_excerpt",
    "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40,64}$",
      "description": "The sdlc/issue-<n> branch head the failure happened on; null when the branch did not exist, absent when it could not be read. The packet is handed over only while the branch still stands there, so a rework of newer code is never told to fix an older error, and one whose head is unknown is never handed over."
    },
    "stage": {
      "type": "string",
      "enum": [
        "intake",
        "plan",
        "implement",
        "ci",
        "review",
        "qa",
        "root-cause",
        "gate",
        "maintainer",
        "project"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "occurrences": {
      "type": "integer",
      "minimum": 1,
      "description": "How many times in a row this exact signature has just failed."
    },
    "error_type": {
      "type": "string",
      "enum": [
        "syntax",
        "type",
        "test-fail",
        "lint",
        "build",
        "tool-error",
        "schema-invalid",
        "timeout",
        "exception",
        "unknown"
      ]
    },
    "error_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{8,64}$",
      "description": "Hash of the error with run-to-run noise stripped, so the same mistake twice is recognisable as the same mistake."
    },
    "raw_excerpt": {
      "type": "string",
      "minLength": 1,
      "description": "The actual compiler/test/runner output. NOT a summary \u2014 the summary is what failed to be enough last time."
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "description": "One to three lines a human reads first."
    },
    "decision": {
      "type": "string",
      "enum": [
        "fix",
        "root-cause",
        "escalate",
        "triage"
      ]
    },
    "decision_reason": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_order_version": {
          "type": "integer",
          "minimum": 1
        },
        "diff_ref": {
          "type": "string",
          "description": "Commit sha or branch the failure was produced from."
        },
        "failed_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run_url": {
          "type": "string"
        },
        "prior_signatures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What has already failed on this issue, newest last, so a pattern is visible without reading every run."
        }
      }
    },
    "triage": {
      "type": "object",
      "description": "The failure-triage agent's reading of this failure, added by apply-triage after the packet was built.",
      "required": [
        "verdict",
        "diagnosis",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "rerun",
            "resume",
            "repair",
            "replan",
            "wait",
            "escalate"
          ]
        },
        "diagnosis": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "framework_defect": {
          "type": "object",
          "required": [
            "file",
            "what",
            "fix"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "what": {
              "type": "string"
            },
            "fix": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
